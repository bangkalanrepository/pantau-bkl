# Salin file ini menjadi `.env` jika ingin menimpa konfigurasi default.
# Tidak ada variabel yang WAJIB diisi — kedua API yang dipakai bersifat publik
# dan tidak membutuhkan API key.

# Base URL endpoint prakiraan cuaca BMKG (opsional).
# VITE_BMKG_API_BASE=https://api.bmkg.go.id/publik/prakiraan-cuaca

# Base URL endpoint kualitas udara Open-Meteo (opsional).
# VITE_OPEN_METEO_AQI_BASE=https://air-quality-api.open-meteo.com/v1/air-quality
